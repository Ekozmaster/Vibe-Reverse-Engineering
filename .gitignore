# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Build artifacts (compiled objects)
*.obj
*.o
*.asi
*.lib
*.exp
*.pdb
*.ilk

# Compiled binaries — allowlist for the few reference DLLs we actually track
*.dll
*.exe
!graphics/directx/dx9/tracer/src/*.dll
!rtx_remix_tools/dx/remix-comp-proxy/assets/*.dll

# Per-game patches: track docs/source/configs, skip large vendor/build outputs.
# (build/ artefacts and *.pdb/*.dll/*.exe/*.lib are already excluded above; these
# are belt-and-braces so a stray addition can't sneak in.)
patches/*/build/
patches/*/deps/dxsdk/
patches/*/deps/remix-bridge-x86/
rtx_remix_tools/dx/remix-comp-proxy/build/

# D3D9 tracer runtime artifacts
dxtrace_capture.trigger
dxtrace_progress.txt
dxtrace_frame.jsonl

# livetools daemon state
livetools/.state.json
livetools/.daemon.log

# IDE / Editor
.vs/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Signature DB (downloaded via sigdb.py pull)
retools/data/signatures.db
retools/data/sources/
*.db-shm
*.db-wal

# Ghidra + JDK (downloaded via verify_install.py --setup)
tools/ghidra_*/
tools/jdk-*/

# Large downloaded archives (RTX Remix runtime staging)
tools/rtx_remix_dl/

# Game install: ignore by default, allowlist diagnostic logs + our helper scripts.
FEAR Ultimate Shooter Edition/*
!FEAR Ultimate Shooter Edition/rtx_comp/
FEAR Ultimate Shooter Edition/rtx_comp/*
!FEAR Ultimate Shooter Edition/rtx_comp/*.log
!FEAR Ultimate Shooter Edition/capture_nvremix_cmdline.ps1
!FEAR Ultimate Shooter Edition/capture_nvremix_cmdline.log
!FEAR Ultimate Shooter Edition/launch_remix_test.ps1

# FEARRTX/ is its own git repo (placeholder content); not absorbed here.
FEARRTX/

# Research artifacts
compass_artifact_*

# Agent memory & transient harness state (machine-specific)
.claude/agent-memory/
.claude/scheduled_tasks.lock

# Superpowers specs/plans (session artifacts)
docs/
